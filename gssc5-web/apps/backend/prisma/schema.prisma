generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

generator prismabox {
  provider                     = "prismabox"
  output                       = "../src/generated/prismabox"
  typeboxImportDependencyName  = "elysia"
  typeboxImportVariableName    = "t"
  inputModel                   = true
}

datasource db {
  provider = "sqlite"
}

// @relation(GSSC-BLLR-13, scope=range_start, role=Implementation)
model User {
  // @relation(GSSC-BLLR-25, scope=range_start, role=Implementation)
  id             String       @id @default(cuid())
  // @relation(GSSC-BLLR-25, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-14, GSSC-BLLR-18, scope=range_start, role=Implementation)
  /// @prismabox.options{ minLength: 1 }
  username       String       @unique
  // @relation(GSSC-BLLR-14, GSSC-BLLR-18, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-15, GSSC-BLLR-19, scope=range_start, role=Implementation)
  /// @prismabox.options{ minLength: 1 }
  primaryEmail   String?      @unique
  // @relation(GSSC-BLLR-15, GSSC-BLLR-19, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-16, scope=range_start, role=Implementation)
  /// @prismabox.options{ minLength: 1 }
  secondaryEmail String?
  // @relation(GSSC-BLLR-16, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-17, scope=range_start, role=Implementation)
  /// @prismabox.hide
  passwordHash   String
  // @relation(GSSC-BLLR-17, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-26, scope=range_start, role=Implementation)
  firstName      String?
  // @relation(GSSC-BLLR-26, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-27, scope=range_start, role=Implementation)
  middleName     String?
  // @relation(GSSC-BLLR-27, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-28, scope=range_start, role=Implementation)
  lastName       String?
  // @relation(GSSC-BLLR-28, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-29, scope=range_start, role=Implementation)
  primaryPhone   String?
  // @relation(GSSC-BLLR-29, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-30, scope=range_start, role=Implementation)
  secondaryPhone String?
  // @relation(GSSC-BLLR-30, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-33, scope=range_start, role=Implementation)
  preferredContactMethod String?
  // @relation(GSSC-BLLR-33, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-32, scope=range_start, role=Implementation)
  secondaryEmailDisplay Boolean @default(false)
  // @relation(GSSC-BLLR-32, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-31, scope=range_start, role=Implementation)
  secondaryPhoneDisplay Boolean @default(false)
  // @relation(GSSC-BLLR-31, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-34, scope=range_start, role=Implementation)
  homeLine1        String?
  homeLine2        String?
  homeLine3        String?
  homeCity         String?
  homeState        String?
  homeZip          String?
  homeZipExtension String?
  // @relation(GSSC-BLLR-34, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-35, scope=range_start, role=Implementation)
  homeAddressDisplay String?
  // @relation(GSSC-BLLR-35, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-36, scope=range_start, role=Implementation)
  mailingLine1        String?
  mailingLine2        String?
  mailingLine3        String?
  mailingCity         String?
  mailingState        String?
  mailingZip          String?
  mailingZipExtension String?
  // @relation(GSSC-BLLR-36, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-37, scope=range_start, role=Implementation)
  isAdmin   Boolean @default(false)
  // @relation(GSSC-BLLR-37, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-38, scope=range_start, role=Implementation)
  isUserMod Boolean @default(false)
  // @relation(GSSC-BLLR-38, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-344, scope=range_start, role=Implementation)
  isToolEditor Boolean @default(false)
  // @relation(GSSC-BLLR-344, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-355, scope=range_start, role=Implementation)
  isPublicationEditor Boolean @default(false)
  // @relation(GSSC-BLLR-355, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-64, scope=range_start, role=Implementation)
  membershipStatus String?
  // @relation(GSSC-BLLR-64, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-275, scope=range_start, role=Implementation)
  position String?
  // @relation(GSSC-BLLR-275, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-276, scope=range_start, role=Implementation)
  accountPhoto String?
  // @relation(GSSC-BLLR-276, scope=range_end, role=Implementation)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tokens         LoginToken[]
  // @relation(GSSC-BLLR-244, scope=range_start, role=Implementation)
  passwordHistory PasswordHistory[]
  // @relation(GSSC-BLLR-244, scope=range_end, role=Implementation)
  // @relation(GSSC-BLLR-245, scope=range_start, role=Implementation)
  recoveryTokens PasswordRecoveryToken[]
  // @relation(GSSC-BLLR-245, scope=range_end, role=Implementation)

  @@map("users")
}
// @relation(GSSC-BLLR-13, scope=range_end, role=Implementation)

// @relation(GSSC-BLLR-317, scope=range_start, role=Implementation)
model LoginToken {
  id        String   @id @default(cuid())
  /// @prismabox.hide
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt  DateTime
  expiresAt DateTime

  @@map("login_tokens")
}
// @relation(GSSC-BLLR-317, scope=range_end, role=Implementation)

// @relation(GSSC-BLLR-244, GSSC-BLLR-262, scope=range_start, role=Implementation)
model PasswordHistory {
  id           String   @id @default(cuid())
  /// @prismabox.hide
  passwordHash String
  // user cuid
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("password_history")
}
// @relation(GSSC-BLLR-244, GSSC-BLLR-262, scope=range_end, role=Implementation)

// @relation(GSSC-BLLR-245, scope=range_start, role=Implementation)
model PasswordRecoveryToken {
  id           String    @id @default(cuid())
  /// @prismabox.hide
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryEmail String
  issuedAt     DateTime
  expiresAt    DateTime
  usedAt       DateTime?

  @@map("password_recovery_tokens")
}
// @relation(GSSC-BLLR-245, scope=range_end, role=Implementation)

// Global website data (GSSC-BHLR-119). Public Footer reads society contact keys.
// @relation(GSSC-BLLR-306, GSSC-BLLR-307, GSSC-BLLR-308, scope=range_start, role=Implementation)
model KeyValue {
  key   String @id
  value String

  @@map("key_value")
}
// @relation(GSSC-BLLR-306, GSSC-BLLR-307, GSSC-BLLR-308, scope=range_end, role=Implementation)

// Content templates (GSSC-BHLR-186).
// @relation(GSSC-BLLR-340, scope=range_start, role=Implementation)
model ContentTemplate {
  id         String          @id @default(cuid())
  name       String
  isPublic   Boolean
  /// JSON string array of tag strings
  tags       String          @default("[]")
  createPerm Int             @default(0)
  modifyPerm Int             @default(0)
  deletePerm Int             @default(0)
  entries    PageDataEntry[]

  @@map("page_templates")
}
// @relation(GSSC-BLLR-340, scope=range_end, role=Implementation)

// Sections, announcements, and event details share one table (GSSC-BHLR-185 / 187).
// @relation(GSSC-BLLR-338, GSSC-BLLR-339, scope=range_start, role=Implementation)
model PageDataEntry {
  id         String           @id @default(cuid())
  /// "section" | "announcement" | "event"
  datatype   String
  header     String?
  body       String
  /// JSON string array of resource identifiers
  resources  String           @default("[]")
  /// JSON string array of tag strings
  tags       String           @default("[]")
  index      Int              @default(0)
  isPublic   Boolean
  createPerm Int              @default(0)
  modifyPerm Int              @default(0)
  deletePerm Int              @default(0)
  templateId String?
  template   ContentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([datatype, index])
  @@map("page_data")
}
// @relation(GSSC-BLLR-338, GSSC-BLLR-339, scope=range_end, role=Implementation)

// Research tools catalog (GSSC-BHLR-194 / GSSC5-18).
// @relation(GSSC-BLLR-343, scope=range_start, role=Implementation)
model ResearchTool {
  id             String @id @default(cuid())
  /// @prismabox.options{ minLength: 1 }
  title          String
  /// @prismabox.options{ minLength: 1 }
  referenceLink  String

  @@map("research_tools")
}
// @relation(GSSC-BLLR-343, scope=range_end, role=Implementation)

// Publications catalog (GSSC-BHLR-201 / GSSC5-19).
// @relation(GSSC-BLLR-354, scope=range_start, role=Implementation)
model Publication {
  id            String  @id @default(cuid())
  /// @prismabox.options{ minLength: 1 }
  title         String
  /// @prismabox.options{ minLength: 1 }
  referenceLink String
  description   String?

  @@map("publications")
}
// @relation(GSSC-BLLR-354, scope=range_end, role=Implementation)
