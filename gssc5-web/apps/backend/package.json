    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "bun-types": "1.4.4",
    "prisma": "7.10.1"
  }
}
