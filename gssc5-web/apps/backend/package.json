{
  "name": "@gssc/backend",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bunx --bun prisma generate && bun build ./src/index.ts --outdir ../../dist/backend --target bun",
