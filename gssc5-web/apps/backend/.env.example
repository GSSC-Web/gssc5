# Backend configuration. Copy to .env. Values already set in the shell win.
PORT=3000
NODE_ENV=development
DATABASE_URL=file:./data/dev.db

# Login token lifetime, in days.
LOGIN_TOKEN_LIFETIME_DAYS=7

# Permanent admin account. Created on startup only when ADMIN_ENABLED is true.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# Empty leaves the admin Primary Email unset. The value is not checked as an email.
ADMIN_EMAIL=
ADMIN_ENABLED=false

# Password change and recovery.
PASSWORD_HISTORY_COUNT=3
PASSWORD_MIN_LENGTH=8
PASSWORD_RECOVERY_LIFETIME_DAYS=1

# SMTP for password recovery mail. Empty SMTP_HOST leaves sending unable to complete.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
