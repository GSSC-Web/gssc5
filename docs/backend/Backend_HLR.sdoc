<<<
DERIVED: False
CHANGE_DRIVER: GSSC5-12
REVIEW_STATUS: Approved
RELATIONS:
- TYPE: Parent
  VALUE: GSSC-PIR-44
  ROLE: Refines
- TYPE: Parent
  VALUE: GSSC-PIR-50
  ROLE: Refines

